rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@insyrlearning.com';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'mobile', 'photoUrl', 'password', 'stream', 'exam']));
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /videos/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /recordedClasses/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /materials/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /pyqs/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /mockTests/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /attempts/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /feedback/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
